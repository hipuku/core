{
  "name": "core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A team decision log — architecture decision records with a permission-gated lifecycle, two audit trails, and citations to the code they govern.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "matter-js": "^0.20.0",
    "mermaid": "^11.17.0",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.9.0 || ^22.0.0 || >=24.0.0"
  }
}
