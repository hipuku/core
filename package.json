{
  "name": "core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A team decision log: architecture decision records with a permission-gated lifecycle, two audit trails, and citations to the code they govern.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:prose": "node scripts/check-punctuation.mjs",
    "lint:css": "stylelint \"**/*.css\" --report-needless-disables",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:tokens": "node scripts/check-token-debt.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "better-auth": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "haus-components": "^2.2.0",
    "haus-tokens": "^3.1.0",
    "lucide-react": "^1.41.0",
    "matter-js": "^0.20.0",
    "mermaid": "^11.17.2",
    "next": "16.3.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
