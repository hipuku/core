# Postgres connection string. A free Neon or Supabase database works for local
# development. Copy this file to .env.local and fill it in; never commit real
# credentials — .env* is gitignored apart from this example.
DATABASE_URL=

# better-auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin the app is served from. Match the port you actually run on.
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth — optional. Without these, everything works except connecting a
# repository and citing files from it; the Connect GitHub button is hidden and
# auth falls back to email + password alone.
#
# Register at https://github.com/settings/developers → New OAuth App, with the
# callback URL <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
