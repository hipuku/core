# Postgres connection string. A free Neon or Supabase database works for local
# development. Copy this file to .env.local and fill it in; never commit real
# credentials — .env* is gitignored apart from this example.
DATABASE_URL=

# better-auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The origin the app is served from. Match the port you actually run on.
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth — optional. Without these, everything works except connecting a
# repository and citing files from it; the Connect GitHub button is hidden and
# auth falls back to email + password alone.
#
# Register at https://github.com/settings/developers → New OAuth App, with the
# callback URL <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Public-deployment flags. Leave all of these unset locally. -------------
#
# `1` closes sign-up entirely: /sign-up 404s and the link to it disappears. The
# public deployment has one seeded account and nothing for anyone to create — an
# invite code is a shared secret, not access control, since whoever holds it can
# pass it on.
DISABLE_SIGNUP=

# `1` switches off GitHub linking even when the OAuth credentials above are set.
# The app requests the `repo` scope — read *and write* on private repositories —
# and a public deployment holding a stranger's token with that reach is not a
# risk worth taking for a demo.
DISABLE_GITHUB=

# The account the public demo signs in as. When set, that account may write
# drafts but cannot change the decision log, and these credentials are shown on
# the sign-in page. `npm run db:seed` creates it.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
